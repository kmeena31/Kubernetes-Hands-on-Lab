name: Test Pre-installed Docker

# This triggers the action every time you push code to the main branch
on:
  push:
    branches: [ "main" ]

jobs:
  run-lab-part-a:
    # "ubuntu-latest" is the GitHub-hosted runner that comes with Docker
    runs-on: ubuntu-latest

    steps:
      # Step 1: Download your repository code onto the runner
      - name: Checkout project code
        uses: actions/checkout@v4

      # --- STEP 1: Check Docker is ready & create lab folder ---
      - name: "Step 1: Check Docker & Setup"
        run: |
          echo ""
          docker --version
          docker info --format '{{.ServerVersion}}'
          docker run --rm hello-world
          mkdir module1-lab

      # --- STEP 2: pull an image and look at its layers ---
      - name: "Step 2: Pull Nginx Image & history"
        run: |
          cd module1-lab
          echo "========Docker pull command=============="
          docker pull nginx:1.28-alpine
          echo "========Docker images nginx Command======"
          docker images nginx
          echo "========Docker image history command======="
          docker image history nginx:1.28-alpine

      # --- STEP 3: Run your first container (foreground, then detached) ---
      # Note: We skip the interactive foreground blocking step (Ctrl+C) so the pipeline doesn't hang!
      - name: "Step 3: Run your first container"
        run: |
          cd module1-lab
          echo "========Run detached nginx container======="
          docker run --rm -d --name web -p 8080:80 nginx:1.28-alpine
          echo "============checking docker ps command============="
          docker ps --filter "name=web"
          echo "========Check title======="
          sleep 3 # Give nginx a moment to wakeup
          curl -s http://localhost:8080 |grep title 
          echo "========docker logs ================"
          docker logs web 

          # --- STEP 4: Walk through the container lifecycle ---
      - name: "Step 4: Pause, Unpause, Stop Lifecycle"
        run: |
          cd module1-lab
          docker inspect -f '{{.State.Status}}' web
          echo "===========docker pause status========="
          docker pause web
          docker inspect -f '{{.State.Status}}' web
          echo "===========docker unpause status========="
          docker unpause web
          docker inspect -f '{{.State.Status}}' web
        #   echo "===========docker stop status========="
        #   docker stop web
        #   docker inspect -f '{{.State.Status}} (exit code {{.State.ExitCode}})' web
        #   echo "===========docker ps -a ========="
        #   docker ps -a

        #   docker start web
       ## --- STEP 5: Read logs and open a shell inside ---
      # Note: We simulate the interactive shell step by passing commands straight to the terminal
      - name: "Step 5: View Logs & Execute Command Inside"
        run: |
          cd module1-lab
          curl -s http://localhost:8080 > /dev/null
          echo "===========docker logs==========="
          docker logs --tail 10 web
          echo "=========Docker exec to check release version============="
          docker exec web cat /etc/os-release | head -1
          echo "=========Docker exec to check ls command ============="
          docker exec web ls /usr/share/nginx/html

         #  # --- STEP 6: Inspect and debug like an operator ---
      - name: "Step 6: Inspect Metadata and Stats"
        run: |
          cd module1-lab
          # docker inspect web | head -30
          echo "===== To check .config.image file =============="
          docker inspect -f '{{.Config.Image}}' web
          echo "===== To check .Network.setting file =============="
          docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' web
          echo "=======To check docker stats =============="
          docker stats web --no-stream
          echo "=======To check top stats =============="
          docker top web
          echo "=======To check docker port =============="
          docker port web

        # --- STEP 7: stop vs kill — see the difference ---
      - name: "Step 7: Compare Stop vs Kill Exit Codes"
        continue-on-error: true  #Tell GitHub to ignore errors on that specific step
        run: |
          cd module1-lab
          echo "=======Docker web is stopping======="
          docker stop web
          echo "=======Docker web is stopped======="
          docker inspect -f 'web -> exit code {{.State.ExitCode}}' web
          echo "=======Deleting web container======="
          docker rm web
         